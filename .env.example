NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hireai
# Use a unique random value of at least 32 characters; never reuse this example.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
ADZUNA_APP_ID=replace-with-your-adzuna-app-id
ADZUNA_APP_KEY=replace-with-your-adzuna-app-key
# Local Vite origin. In production, set the exact HTTPS frontend origin(s).
FRONTEND_URL=http://localhost:5173
# Number of trusted reverse-proxy hops. Use 0 locally; use the actual ingress topology in production.
TRUST_PROXY=0
